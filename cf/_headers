# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Workers Static Assets header rules for ShahZap.
# Copied to .open-next/assets/_headers by scripts/cf-cache.mjs before deploy.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# ─────────────────────────────────────────────────────────────────────────────

# Immutable, content-hashed build output (JS/CSS/fonts hashed by Next.js).
# Safe to cache for a year — a new deploy produces new filenames.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must always revalidate so updates ship promptly.
/sw.js
  Cache-Control: no-cache

# PWA manifest changes rarely but must not be pinned forever.
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Static media & fonts (present or future) — month-long browser cache
/*.svg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
