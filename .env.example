# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=https://shahzap.safiullahkorai.com

# Paddle payments (required for Phase 13C-2)
# Obtain these from your Paddle dashboard: https://dashboard.paddle.com
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price IDs mapped to ShahZap product identifiers — set these in your
# environment or a remote config store (not secrets, but configuration):
PADDLE_PREMIUM_MONTHLY_PRICE_ID=
PADDLE_PREMIUM_YEARLY_PRICE_ID=

# Adsterra ads — banner keys from the Adsterra publisher dashboard
# (account 3436789, website 6001372). Public values: set them as runtime
# vars in wrangler.jsonc and/or .env.local for local dev.
#   728x90 leaderboard · 300x250 medium rectangle (also used for rewarded) · 160x600 skyscraper
NEXT_PUBLIC_ADSTERRA_728X90=
NEXT_PUBLIC_ADSTERRA_300X250=
NEXT_PUBLIC_ADSTERRA_160X600=

# Optional: if you use Cloudflare Turnstile for bot protection
# NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=